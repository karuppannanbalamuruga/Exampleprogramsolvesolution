	static void armstrong(int a)
	{
		int x = a;
		int temp = 0;
		int count = 0;
		while(a>0)
		{
			count++;
			a=a/10;
		}
		int res = 0;
		while(x>0)
		{
			int c = x%10;
			res = (int)(res + Math.pow(c, count));
			x=x/10;
		}
		if(temp==res)
		{
			System.out.println("Armstrong number");
		}
		else
		{
			System.out.println("Not a Armstrong number");
		}
	}
	
